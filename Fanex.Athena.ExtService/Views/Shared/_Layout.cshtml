@using Fanex.Athena.ExtService.Common.Services;
@using Microsoft.AspNetCore.Http;
@using Microsoft.Extensions.Configuration
@using Fanex.Athena.ExtService.Common.Models.DTO
@inject IConfiguration Configuration
@inject ICommonService CommonService
@using Fanex.Athena.ExtService.Common.Models.ViewModels
@{
    Layout = null;

    var appSettings = Configuration.GetSection("AppSettings").Get<AppSettings>();
    var langCode = System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag;
    var siteName = Context.User.Identity.Name ?? "";
    var isHideSaba = false;

    if (!string.IsNullOrEmpty(siteName))
    {
        var specialPlatform = CommonService.GetSpecialPlatform(siteName);
        isHideSaba = specialPlatform == 2 || specialPlatform == 3;
    }
}
@model BaseViewModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>LAP - External service @ViewBag.Title</title>
    <meta name="description" content="The Risk & Forecast System" />
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true"/>
    @RenderSection("pagecss", required: false)
</head>
<body>
    <input type="hidden" id="RootUrl" value="@Url.Content("~/")" />
    <input type="hidden" id="access_token" value="@Model.AccessToken" />
    <input type="hidden" id="lang" value="@Model.Lang" />
    <input type="hidden" id="baseCurrency" value="@Model.BaseCurrency" />
    <input type="hidden" id="IsHideSaba" value="@( isHideSaba ? 1 : 0)" />

    <div class="loading" style="display: none">
        <div class="icon-loading">
            <div class="loader-inner ball-beat">
                <span class="icon-ball"></span>
                <span class="icon-ball"></span>
                <span class="icon-ball"></span>
            </div>
        </div>
    </div>
    <div class="block-body" style="display: none">
    </div>
    <div class="wrapper">
        @RenderBody()
    </div>
    <script src="~/js/language.chunk.js"  asp-append-version="true"></script>
    <script type="text/javascript">
        window._pageLanguage = '@Model.Lang';
    </script>
    @if (langCode != "en-US")
    {
        <script src="@Url.Content($"~/js/language-" + langCode + ".chunk.js")"  asp-append-version="true"></script>
    }
    <script src="@Url.Content($"~/js/pages/lib/common.chunk.js")"  asp-append-version="true"></script>
    @if (ViewData["IntegrateBetTicketSite"] as bool? == true)
    {
        <script src="@appSettings.BetTicketEventBuilderUrl" id="event-builder-script"></script>
    }
    @RenderSection("Scripts", required: false)
    @if (appSettings.Environment.Equals("PROD", StringComparison.OrdinalIgnoreCase) ||
        appSettings.Environment.Equals("KLPROD", StringComparison.OrdinalIgnoreCase))
    {
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-M09N5LNEH1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', 'G-M09N5LNEH1', {
                cookie_flags: 'secure;samesite=none'
            });
            gtag('config', 'UA-93927620-1', {
                cookie_flags: 'secure;samesite=none'
            });

        </script>

    }
</body>
</html>
