@using Fanex.Athena.ExtService.Resources
@using Microsoft.Extensions.Configuration
@using Fanex.Athena.ExtService.Common.Models.DTO
@using Fanex.Athena.ExtService.Common.Models.DataDomain
@inject IConfiguration Configuration
@{
    ViewData["IntegrateBetTicketSite"] = true;
    var startIndex = (Model.PageIndex - 1) * Model.PageSize + 1;
    var isAllowTxIDColumn = (bool)ViewBag.IsEnableSingleWallet;
    var title = Model.ViewType == SystemConstants.DefaultViewType ? @ViewResources.Statement : $"{ViewResources.SabaCoins} {ViewResources.Statement}";
}
@section pagecss
    {
    <link href="~/css/pages/betlist/betlistLayout.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/betlist/betlistRefno.css" rel="stylesheet" asp-append-version="true" />
}
@section Scripts
    {
    <script src="~/js/pages/betlist/refno.chunk.js" asp-append-version="true"></script>
    <script type="text/javascript">

    </script>
}
@model Fanex.Athena.ExtService.BetList.Models.ViewModel.BetListByProductViewModel
<div id="container" class="container-fluid">
    <div>
        @if (ViewBag.ShowBreadCrumb)
        {
            var breadcrumbItems = new List<SelectListItem>
{
        new SelectListItem { Text = title, Value = Url.Action("Summary", "Statement", new {
vt=Model.ViewType,
cid=Model.CustId,
fd=ViewBag.FromDate.ToString("MM/dd/yyyy"),
td=ViewBag.ToDate.ToString("MM/dd/yyyy"),
bc=Model.BaseCurrency,
lang=Model.Lang,
ps=ViewBag.StatementPageSize,
pi=ViewBag.StatementPageIndex,
sb=ViewBag.ShowBreadCrumb,
access_token=Model.AccessToken,
isDesktopViewOnly =Model.IsDesktopViewOnly
}
)
},
new SelectListItem { Text = ViewResources.BettingStatement, Value = Url.Action("ByGroup", "Statement", new {
vt=Model.ViewType,
cid=Model.CustId,
wd=Model.WinlostDate.ToString("MM/dd/yyyy"),
mv=Model.TransType,
fd=ViewBag.FromDate.ToString("MM/dd/yyyy"),
td=ViewBag.ToDate.ToString("MM/dd/yyyy"),
bc=Model.BaseCurrency,
lang=Model.Lang,
ps=ViewBag.StatementPageSize,
pi=ViewBag.StatementPageIndex,
sb=ViewBag.ShowBreadCrumb,
access_token=Model.AccessToken,
isDesktopViewOnly =Model.IsDesktopViewOnly
}
)
},
new SelectListItem { Text = ViewResources.BetList, Selected = true, Value = "javascript:;" }
};
<breadcrumb items="@breadcrumbItems"></breadcrumb>
}
        <div class="betlist-container result-content tbl-betlist mobile">
            <div class="report-title-container">
                <p class="report-title">
                    @Model.TransDesc
                </p>
            </div>
            <div>
                <div class="table-container">
                    <div class="header-content">
                        <div class="table-wrapper">
                            <table class="table">
                                <thead>
                                    <tr class="first-row">
                                        <td style="width:46%"></td>
                                        <td></td>
                                        <td></td>
                                        <td style="width:30px"></td>
                                    </tr>
                                    <tr style="height:32px;">
                                        <th class="text-left">@ViewResources.Details</th>
                                        <th class="text-right">@ViewResources.Stake</th>
                                        <th class="text-right">
                                            @(Model.Info.IsAllowedCustomerComm ? $"{ ViewResources.WinLoss}/{ ViewResources.Comm}" : @ViewResources.WinLoss)
                                        </th>
                                        <th></th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                    <div class="body-content">
                        <div class="table-wrapper">
                            <table class="table">
                                <tbody>
                                    <tr class="first-row">
                                        <td style="width:46%"></td>
                                        <td></td>
                                        <td></td>
                                        <td style="width:30px"></td>
                                    </tr>
                                    @for (var i = 0; i < Model.Data.Count; i++)
                                    {
                                        var item = Model.Data[i];

                                        <tr>
                                            <td>
                                                <div class="elm-block">
                                                    <span class="elm-index">#@((i + startIndex).ToString("N0"))</span> - <span>@Html.Raw(item.TransTime)</span>
                                                </div>
                                                <div class="elm-block">@Html.Raw(item.RefNo)</div>
                                                <div class="elm-block">@Html.Raw(item.Choice)</div>
                                                <div class="elm-block elm-odd">
                                                    <span>@@</span>@Html.Raw(item.Odds)&nbsp;<span>@Html.Raw(item.OddsType)</span>
                                                </div>
                                            </td>
                                            <td class="right-align">
                                                @Html.Raw(item.Stake)
                                            </td>
                                            <td class="right-align">
                                                @Html.Raw(item.WinLoss)
                                                <br />
                                                @Html.Raw(item.Status)
                                            </td>
                                            <td class="center-align"><span class="icon-show-more collapsed" data-refno="@item.RefNo"></span></td>
                                        </tr>

                                        <tr data-refno="@item.RefNo" class="more-info hide">
                                            <td colspan="4">
                                                <table>
                                                    @if (isAllowTxIDColumn)
                                                    {
                                                        <tr>
                                                            <td class="col-key">@ViewResources.LicenseeTxId</td>
                                                            <td class="col-value">@Html.Raw(item.LicenseeTxId)</td>
                                                        </tr>
                                                    }
                                                    @if (Model.ViewType == SystemConstants.DefaultViewType)
                                                    {
                                                        <tr>
                                                            <td class="col-key">
                                                                @ViewResources.LicenseeWL/
                                                                <br />
                                                                @ViewResources.Comm
                                                            </td>
                                                            <td class="col-value licensee-wl">@Html.Raw(item.LicenseeWL)</td>
                                                        </tr>
                                                    }
                                                    <tr>
                                                        <td class="col-key">@ViewResources.Platform</td>
                                                        <td class="col-value">@Html.Raw(item.Platform)</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="col-key">@ViewResources.Live</td>
                                                        <td class="col-value">@Html.Raw(item.Live)</td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.TotalRows > 50)
        {
            <pager page-index="@Model.PageIndex"
                   page-size="@Model.PageSize"
                   total-items="@Model.TotalRows"
                   custom-class="tbl-betlist mobile"
                   url-template="@Url.Action("ByGroup", "BetList", new
                            {
                                vt=Model.ViewType,
                                cid = Model.CustId,
                                lang = Model.Lang,
                                bc = Model.BaseCurrency,
                                wd = Model.WinlostDate.ToString("MM/dd/yyyy"),
                                pc = Model.ProductCode,
                                mv = Model.TransType,
                                s = Model.Sort,
                                fd = ViewBag.FromDate.ToString("MM/dd/yyyy"),
                                td = ViewBag.ToDate.ToString("MM/dd/yyyy"),
                                sb = ViewBag.ShowBreadCrumb,
                                spi = ViewBag.StatementPageIndex,
                                sps = ViewBag.StatementPageSize,
                                access_token = Model.AccessToken,
                                isDesktopViewOnly =Model.IsDesktopViewOnly
                            })">
            </pager>
        }
    </div>
    <input type="hidden" id="isDesktopViewOnly" value="@(Model.IsDesktopViewOnly ? 1 : 0)" />
</div>
