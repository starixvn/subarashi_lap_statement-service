@inject IConfiguration Configuration


@{
    Layout = null;

}
@using Fanex.Athena.ExtService.Resources
@using Microsoft.Extensions.Configuration
@model Fanex.Athena.ExtService.BetList.Models.ViewModel.SystemParlayDetailViewModel

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@string.Format("LAP - {0}", ViewResources.SystemParlay)</title>
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/css/pages/betlist/systemparlaydetail.css" rel="stylesheet" type="text/css" asp-append-version="true"/>
</head>
<body>
    <div class="system-parlay-detail-container">
        @Html.Raw(Model.DetailText)

        <div class="note-block">
            <p class="text-bold"><span class="red-text">* </span>@ViewResources.Note</p>
            <p>@ViewResources.SystemParlayDetailNote</p>
        </div>
    </div>
</body>
</html>