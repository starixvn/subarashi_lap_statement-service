@using Fanex.Athena.ExtService.Resources
@using Microsoft.Extensions.Configuration
@using Fanex.Athena.ExtService.Common.Models.DTO
@using Fanex.Athena.ExtService.Common
@inject IConfiguration Configuration
@{
    var appSettings = Configuration.GetSection("AppSettings").Get<AppSettings>();
    var env = appSettings.Environment.Equals("PROD") ? "pro" : "dev";
    var licenseeAllowTxIDColumn = appSettings.LicenseeOfferTxIDColumn.Split(',');
    var isAllowTxIDColumn = licenseeAllowTxIDColumn.Contains(Model.Info.SiteName, StringComparer.InvariantCultureIgnoreCase);
}
@section pagecss
    {
    <link href="@Url.Content($"~/css/build/{env}/pages/betlist/betlistLayout.css")" rel="stylesheet" />
    <link href="@Url.Content($"~/css/build/{env}/pages/betlist/betlistRefno.css")" rel="stylesheet" />
}
@section Scripts
    {
    <script src="@Url.Content($"~/js/build/{env}/pages/betlist/refno.chunk.js")"></script>
    <script type="text/javascript">

    </script>
}
@model Fanex.Athena.ExtService.BetList.Models.ViewModel.RunningBetListByViewModel
<div id="container" class="container-fluid">
    <div>
        <div class="betlist-container result-content tbl-betlist">
            <div>
                <div class="table-container">
                    <div class="header-content">
                        <div class="table-wrapper">
                            <table class="table">
                                <thead>
                                    <tr class="first-row">
                                        <td style="width:39px;"></td>
                                        <td></td>
                                        @if (isAllowTxIDColumn)
                                        {
                                            <td></td>
                                        }
                                        <td></td>
                                        <td style="width:350px"></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr style="height:32px;">
                                        <th>#</th>
                                        <th>@ViewResources.RefNo</th>
                                        @if (isAllowTxIDColumn)
                                        {
                                            <th>@ViewResources.LicenseeTxId</th>
                                        }
                                        <th>@ViewResources.TransTime</th>
                                        <th>@ViewResources.Choice</th>
                                        <th>@ViewResources.Odds</th>
                                        <th>@ViewResources.OddsType</th>
                                        <th>@ViewResources.Stake</th>
                                        <th>@ViewResources.Status</th>
                                        <th>@ViewResources.Platform</th>
                                        <th>@ViewResources.Live</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                    <div class="body-content">
                        <div class="table-wrapper">
                            <table class="table">
                                <tbody>
                                    <tr class="first-row">
                                        <td style="width:39px;"></td>
                                        <td></td>
                                        @if (isAllowTxIDColumn)
                                        {
                                            <td></td>
                                        }
                                        <td></td>
                                        <td style="width:350px"></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    @foreach (var item in Model.Data)
                                    {
                                    <tr>
                                        <td title="@item.Index" class="center-align">
                                            @item.Index
                                        </td>
                                        <td class="center-align">@Html.Raw(item.RefNo)</td>
                                        @if (isAllowTxIDColumn)
                                        {
                                            <td class="center-align">@Html.Raw(item.LicenseeTxId)</td>
                                        }
                                        <td class="center-align">@Html.Raw(item.TransTime)</td>
                                        <td class="right-align">@Html.Raw(item.Choice)</td>
                                        <td class="right-align">@Html.Raw(item.Odds)</td>
                                        <td class="right-align">@Html.Raw(item.OddsType)</td>
                                        <td class="right-align"> @Html.Raw(item.Stake)</td>
                                        <td class="center-align">@Html.Raw(item.Status)</td>
                                        <td class="center-align">@Html.Raw(item.Platform)</td>
                                        <td class="center-align">@Html.Raw(item.Live)</td>
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
