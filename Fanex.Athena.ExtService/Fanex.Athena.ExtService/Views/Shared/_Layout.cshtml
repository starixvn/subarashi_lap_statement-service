@using Microsoft.Extensions.Configuration
@using Fanex.Athena.ExtService.Shared.Models.DTO
@inject IConfiguration Configuration
@{
    Layout = null;

    var appSettings = Configuration.GetSection("AppSettings").Get<AppSettings>();
    var langCode = System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag;
    var env = appSettings.Environment.Equals("PROD") ? "pro" : "dev";
   
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>@ViewData["Title"] - LAP - External service</title>
    <meta name="description" content="The Risk & Forecast System" />
    <link href="@Url.Content($"~/css/build/{env}/main.css")" rel="stylesheet" />
    @RenderSection("pagecss", required: false)
</head>
<body>
    <input type="hidden" id="RootUrl" value="@Url.Content("~/")" />
    @Html.AntiForgeryToken()
    <div class="loading" style="display: none">
        <div class="icon-loading">
            <div class="loader-inner ball-beat">
                <span class="icon-ball"></span>
                <span class="icon-ball"></span>
                <span class="icon-ball"></span>
            </div>
        </div>
    </div>
    <div class="block-body" style="display: none">
    </div>
    <div class="wrapper">
        @RenderBody()
    </div>
    <script src="@Url.Content($"~/js/build/{env}/language.chunk.js")"></script>
    @if (langCode != "en-US")
    {
        <script src="@Url.Content($"~/js/build/{env}/language-" + langCode + ".chunk.js")"></script>
    }
    <script src="@Url.Content($"~/js/build/{env}/pages/lib/common.chunk.js")"></script>
    @RenderSection("Scripts", required: false)
    @if (appSettings.Environment.Equals("PROD", StringComparison.OrdinalIgnoreCase))
    {
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-93927620-1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', 'UA-93927620-1');

            window.logOpenBetlistEvent = function () {
                try {
                    window.gtag('event', 'view_bet_list', {
                        'event_label': 'Bet List Promotion',
                        'event_category': 'bet_list',
                        'non_interaction': true
                    });
                }
                catch (err) {
                }
            };
        </script>
    }
</body>
</html>
